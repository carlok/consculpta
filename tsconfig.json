{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "src/vite-env.d.ts",
    "vite.config.js",
    "vite.engine.config.js",
    "vite.render.config.js",
    "vite.audio.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ]
}
