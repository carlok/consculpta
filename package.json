{
  "name": "consculpta",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:engine": "vite build -c vite.engine.config.js",
    "build:render": "vite build -c vite.render.config.js",
    "build:audio": "vite build -c vite.audio.config.js",
    "build:legacy": "npm run build:engine && npm run build:render && npm run build:audio",
    "build:single": "node scripts/inline-single-file.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "glsl": "node scripts/glsl-check.mjs",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build:legacy && npm run glsl && npm run coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "tone": "15.1.22",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
