  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@types/node": "24.7.0",
    "@playwright/test": "1.55.1",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
